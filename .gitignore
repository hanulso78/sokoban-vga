# 빌드 결과 (build.bat / build_host.sh 로 다시 만든다)
*.o
*.vo
/sokoban.exe
/sokovga.exe
/hosttest.exe
/hostvga.exe

# 도구가 만드는 것
#   python tools/mklist.py   -> listing.asm
#   python tools/mknames.py  -> tools/names.txt
#   python tools/asm2c.py    -> skbcode.c, skbcode.h, skbvars.h
#   python tools/mkdata.py   -> skbdata.c
#   python tools/mkvga.py    -> SKBVGA.DAT
#   python tools/mkmusic.py  -> SOUND.DAT
/listing.asm
/skbcode.c
/skbcode.h
/skbvars.h
/skbdata.c
/SKBVGA.DAT
/SOUND.DAT
/tools/names.txt

# 시험 / 미리보기 부산물
/SKBLOG.TXT
/SKBTEST.TXT
*.BMP
tools/_*
tools/*.png
tools/shots/
tools/shots2/
tools/__pycache__/
tools/sol1.txt

# 기록 백업, 원본 자료 사본 (게임 자료 파일은 이 폴더에 그대로 있다)
/save_orig/
/data/

# 배포 폴더(release/)는 받아서 바로 돌릴 수 있게 저장소에 함께 둔다 (묶음 파일은 뺀다)
/release/*.rar
/release/*.zip
/release/*.7z
/release/*.BMP
/release/SKBLOG.TXT
/release/SKBTEST.TXT
